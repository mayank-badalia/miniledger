# Copy this file to ".env" and adjust if needed.

# Port the API listens on
PORT=4000

# PostgreSQL connection string.
# Matches the docker-compose.yml in the project root.
DATABASE_URL=postgres://miniledger:miniledger@localhost:5434/miniledger

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=dev-super-secret-change-me

# Where the frontend runs, so the API can allow it (CORS).
CLIENT_ORIGIN=http://localhost:5173
